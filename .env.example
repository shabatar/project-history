# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real tokens.

# LLM backend
PT_OLLAMA_BASE_URL=http://host.docker.internal:11434
PT_OLLAMA_CLIENT_MODE=native   # native | openai (for any OpenAI-compatible endpoint)
PT_DEFAULT_MODEL=llama3.1

# API key — protects the app if exposed to a network
PT_API_KEY=

# YouTrack integration — enables the Activity tab
PT_YOUTRACK_ENABLED=false
PT_YOUTRACK_BASE_URL=https://youtrack.example.com
PT_YOUTRACK_API_TOKEN=perm:your-token-here
